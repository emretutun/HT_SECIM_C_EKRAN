//
//  1 yapilirsa uygulama baglanip sahneyi okur okumaz donmeye baslar.
//  Yayin makinesinde 0 birakin: sahne zaten ekranda, uygulama acilir
//  acilmaz goruntuye mudahale etmesin.
//-------------------------------------------------------------

OTOMATIK_BASLA = 0

